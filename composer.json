{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "michal-ziolek/ksef-validator-api",
    "description": "REST API that validates KSeF FA(3) e-invoices in memory.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/ksef-fa3-validator",
            "options": {
                "versions": {
                    "michal-ziolek/ksef-fa3-validator": "0.3.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-apcu": "*",
        "laravel/framework": "^13.42",
        "laravel/octane": "^2.24",
        "michal-ziolek/ksef-fa3-validator": "^0.3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.32.3",
        "opis/json-schema": "^2.6.2",
        "pestphp/pest": "^5.3.5",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
